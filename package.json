{
  "name": "@bridge-craftwork/convention-card",
  "version": "0.4.3",
  "description": "Bridge convention cards: the spec, converters (BBO, bridgeodex, .bbsa) and the ACBL PDFs",
  "license": "MIT OR Apache-2.0",
  "repository": "github:bridge-craftwork/convention-card",
  "type": "module",
  "main": "./js/index.js",
  "exports": {
    ".": "./js/index.js",
    "./js/*": "./js/*",
    "./web/*": "./web/*",
    "./spec/*": "./spec/*",
    "./assets/*": "./assets/*"
  },
  "files": [
    "js/*.js",
    "web/src/",
    "spec/*.json",
    "spec/formats/*.json",
    "assets/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "predev": "node scripts/emit-reference.mjs",
    "dev": "vite web",
    "prebuild": "node scripts/emit-reference.mjs",
    "build": "vite build web"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "jspdf": "^4.2.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.4.0",
    "vitest": "^4.0.17",
    "vue": "^3.4.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
